<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/tvSpecification"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/specification"
        app:layout_editor_absoluteX="16dp"
        app:layout_editor_absoluteY="16dp"/>

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/display"
        app:layout_editor_absoluteX="16dp"
        app:layout_editor_absoluteY="50dp"/>

    <TextView
        android:id="@+id/tvSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/size"
        app:layout_editor_absoluteX="16dp"
        app:layout_editor_absoluteY="120dp"/>

    <TextView
        android:id="@+id/tvContentSpecsDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/content_specs_display"
        app:layout_editor_absoluteX="106dp"
        app:layout_editor_absoluteY="50dp"/>

    <TextView
        android:id="@+id/tvContentSpecsSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/content_specs_size"
        app:layout_editor_absoluteX="106dp"
        app:layout_editor_absoluteY="120dp"/>

    <TextView
        android:id="@+id/tvBattery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/battery"
        app:layout_editor_absoluteX="16dp"
        app:layout_editor_absoluteY="180dp"/>

    <TextView
        android:id="@+id/tvContentSpecsBattery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/content_specs_battery"
        app:layout_editor_absoluteX="106dp"
        app:layout_editor_absoluteY="180dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>